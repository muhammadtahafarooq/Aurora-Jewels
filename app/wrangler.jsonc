{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-jewels",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurora-jewels",
      "database_id": "55d511b6-7b99-4db8-9ae2-f2bb3b452fc6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "5bf3cbe461b941b8958d75184638a04e"
    }
  ]
}
