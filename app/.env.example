# Cloudflare D1 Local Database (for development/local run)
# DB_BINDING_NAME=d1-db

# Brevo API Key for transactional emails (sign up at https://www.brevo.com)
# No domain verification needed — just verify your sender email by clicking the link they send
BREVO_API_KEY=your_brevo_api_key_here

# JWT Signing (used by auth.ts — MUST be set in production)
JWT_SECRET=your_jwt_signing_secret_here

# Administrative Credentials (signed as JWT payload)
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# App Secrets
SESSION_SECRET=your_session_secret_here

# Email & App URL (set in Cloudflare Pages dashboard for production)
FROM_EMAIL=webdevelopmenttestgmail@gmail.com
FROM_NAME=Aurora Jewels
ADMIN_EMAIL=admin@aurorajewels.pk
APP_URL=https://aurorajewels.pk
