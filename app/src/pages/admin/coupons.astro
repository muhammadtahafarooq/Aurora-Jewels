---
export const prerender = false;
import { requireAdminPage } from '../../lib/admin-auth';
if (!await requireAdminPage(Astro)) return Astro.redirect('/admin/login');
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Coupons">
  <div class="max-w-7xl mx-auto px-5 py-8 md:px-8">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-[22px] font-bold" style="color: var(--color-primary);">Coupons</h1>
      <button
        id="showCreateForm"
        class="px-4 py-2 rounded-none font-medium"
        style="background: var(--color-primary); color: white; border: none;"
      >
        Add Coupon
      </button>
    </div>

    <!-- Create Form -->
    <div id="createForm" class="hidden mb-8 p-6 rounded-none border border-border" style="background: var(--color-surface-warm);">
      <h2 class="text-lg font-semibold mb-4" style="color: var(--color-primary);">Create Coupon</h2>
      <form id="couponForm" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Code</label>
          <input
            type="text"
            id="code"
            required
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Discount Type</label>
          <select
            id="discountType"
            required
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          >
            <option value="percentage">Percentage</option>
            <option value="flat">Flat</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Discount Value</label>
          <input
            type="number"
            id="discountValue"
            required
            min="0"
            step="0.01"
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Minimum Order Amount</label>
          <input
            type="number"
            id="minimumOrderAmount"
            required
            min="0"
            step="0.01"
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Expires At</label>
          <input
            type="date"
            id="expiresAt"
            required
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Usage Limit</label>
          <input
            type="number"
            id="usageLimit"
            required
            min="1"
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div class="md:col-span-2 flex gap-2">
          <button
            type="submit"
            class="px-4 py-2 rounded-none font-medium"
            style="background: var(--color-primary); color: white; border: none;"
          >
            Create Coupon
          </button>
          <button
            type="button"
            id="hideCreateForm"
            class="px-4 py-2 rounded-none font-medium"
            style="background: transparent; color: var(--color-muted); border: 1px solid var(--color-border);"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="text-center py-8">
      <p style="color: var(--color-muted);">Loading coupons...</p>
    </div>

    <!-- Error State -->
    <div id="errorState" class="hidden mb-4 p-4 rounded-none" style="background: var(--color-error); color: var(--color-surface); border: 1px solid var(--color-error);">
      <p id="errorMessage"></p>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-12 rounded-none border border-border" style="background: var(--color-surface-warm);">
      <p style="color: var(--color-muted);">No coupons found.</p>
    </div>

    <!-- Coupons Table -->
    <div id="tableContainer" class="hidden overflow-x-auto rounded-none border border-border" style="background: var(--color-surface);">
      <table class="w-full">
        <thead style="background: var(--color-surface-warm);">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Code</th>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Type</th>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Value</th>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Min Order</th>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Expires</th>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Usage</th>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Active</th>
            <th class="px-4 py-3 text-left text-sm font-semibold" style="color: var(--color-primary);">Actions</th>
          </tr>
        </thead>
        <tbody id="couponsTableBody">
        </tbody>
      </table>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="editModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="w-full max-w-md mx-4 p-6 rounded-none border border-border" style="background: var(--color-surface-warm);">
      <h2 class="text-lg font-semibold mb-4" style="color: var(--color-primary);">Edit Coupon</h2>
      <form id="editForm" class="space-y-4">
        <input type="hidden" id="editId" />
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Code</label>
          <input
            type="text"
            id="editCode"
            required
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Discount Type</label>
          <select
            id="editDiscountType"
            required
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          >
            <option value="percentage">Percentage</option>
            <option value="flat">Flat</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Discount Value</label>
          <input
            type="number"
            id="editDiscountValue"
            required
            min="0"
            step="0.01"
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Minimum Order Amount</label>
          <input
            type="number"
            id="editMinimumOrderAmount"
            required
            min="0"
            step="0.01"
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Expires At</label>
          <input
            type="date"
            id="editExpiresAt"
            required
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" style="color: var(--color-text);">Usage Limit</label>
          <input
            type="number"
            id="editUsageLimit"
            required
            min="1"
            class="w-full px-3 py-2 rounded-none border border-border focus:outline-none"
            style="background: white; color: var(--color-text);"
          />
        </div>
        <div class="flex gap-2">
          <button
            type="submit"
            class="px-4 py-2 rounded-none font-medium"
            style="background: var(--color-primary); color: white; border: none;"
          >
            Update Coupon
          </button>
          <button
            type="button"
            id="hideEditModal"
            class="px-4 py-2 rounded-none font-medium"
            style="background: transparent; color: var(--color-muted); border: 1px solid var(--color-border);"
          >
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const API_URL = '/api/admin/coupons';
    let coupons = [];

    // DOM Elements
    const showCreateBtn = document.getElementById('showCreateForm');
    const createFormDiv = document.getElementById('createForm');
    const hideCreateBtn = document.getElementById('hideCreateForm');
    const couponForm = document.getElementById('couponForm');
    const loadingState = document.getElementById('loadingState');
    const errorState = document.getElementById('errorState');
    const errorMessage = document.getElementById('errorMessage');
    const emptyState = document.getElementById('emptyState');
    const tableContainer = document.getElementById('tableContainer');
    const couponsTableBody = document.getElementById('couponsTableBody');
    const editModal = document.getElementById('editModal');
    const editForm = document.getElementById('editForm');
    const hideEditModal = document.getElementById('hideEditModal');

    // Show/Hide Create Form
    showCreateBtn.addEventListener('click', () => {
      createFormDiv.classList.remove('hidden');
      showCreateBtn.classList.add('hidden');
    });

    hideCreateBtn.addEventListener('click', () => {
      createFormDiv.classList.add('hidden');
      showCreateBtn.classList.remove('hidden');
      couponForm.reset();
    });

    // Show/Hide Edit Modal
    hideEditModal.addEventListener('click', () => {
      editModal.classList.add('hidden');
    });

    editModal.addEventListener('click', (e) => {
      if (e.target === editModal) {
        editModal.classList.add('hidden');
      }
    });

    // Helper Functions
    function showError(msg) {
      errorMessage.textContent = msg;
      errorState.classList.remove('hidden');
    }

    function hideError() {
      errorState.classList.add('hidden');
    }

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      const date = new Date(dateStr);
      return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function renderStatusBadge(active) {
      if (active) {
        return `<span class="px-2 py-1 rounded-none text-xs font-medium" style="background: var(--color-success); color: white;">Active</span>`;
      }
      return `<span class="px-2 py-1 rounded-none text-xs font-medium" style="background: var(--color-muted); color: white;">Inactive</span>`;
    }

    function renderTable() {
      if (coupons.length === 0) {
        emptyState.classList.remove('hidden');
        tableContainer.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      tableContainer.classList.remove('hidden');

      couponsTableBody.innerHTML = coupons.map(coupon => `
        <tr class="border-t border-border" style="background: var(--color-surface);">
          <td class="px-4 py-3 text-sm font-medium" style="color: var(--color-text);">${coupon.code}</td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text);">${coupon.discountType === 'percentage' ? 'Percentage' : 'Flat'}</td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text);">${coupon.discountType === 'percentage' ? coupon.discountValue + '%' : '$' + coupon.discountValue}</td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text);">$${coupon.minimumOrderAmount || 0}</td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text);">${formatDate(coupon.expiresAt)}</td>
          <td class="px-4 py-3 text-sm" style="color: var(--color-text);">${coupon.usageCount || 0}/${coupon.usageLimit || '-'}</td>
          <td class="px-4 py-3 text-sm">${renderStatusBadge(coupon.active)}</td>
          <td class="px-4 py-3 text-sm">
            <button class="edit-btn mr-2 px-2 py-1 rounded-none text-xs font-medium" style="background: var(--color-accent); color: white;" data-id="${coupon.id}">Edit</button>
            <button class="delete-btn px-2 py-1 rounded-none text-xs font-medium" style="background: var(--color-error); color: white;" data-id="${coupon.id}">Delete</button>
          </td>
        </tr>
      `).join('');

      // Attach event listeners
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = e.target.dataset.id;
          openEditModal(id);
        });
      });

      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = e.target.dataset.id;
          deleteCoupon(id);
        });
      });
    }

    // Fetch Coupons
    async function fetchCoupons() {
      try {
        loadingState.classList.remove('hidden');
        errorState.classList.add('hidden');
        emptyState.classList.add('hidden');
        tableContainer.classList.add('hidden');

        const response = await fetch(API_URL, { credentials: 'same-origin' });
        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.message || 'Failed to fetch coupons');
        }

        const data = await response.json();
        coupons = Array.isArray(data) ? data : data.coupons || [];
        renderTable();
      } catch (err) {
        showError(err.message || 'Failed to load coupons');
      } finally {
        loadingState.classList.add('hidden');
      }
    }

    // Create Coupon
    couponForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const payload = {
        code: document.getElementById('code').value.trim(),
        discountType: document.getElementById('discountType').value,
        discountValue: parseFloat(document.getElementById('discountValue').value),
        minimumOrderAmount: parseFloat(document.getElementById('minimumOrderAmount').value),
        expiresAt: document.getElementById('expiresAt').value,
        usageLimit: parseInt(document.getElementById('usageLimit').value, 10)
      };

      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.message || 'Failed to create coupon');
        }

        couponForm.reset();
        createFormDiv.classList.add('hidden');
        showCreateBtn.classList.remove('hidden');
        await fetchCoupons();
      } catch (err) {
        showError(err.message || 'Failed to create coupon');
      }
    });

    // Open Edit Modal
    function openEditModal(id) {
      const coupon = coupons.find(c => String(c.id) === String(id));
      if (!coupon) return;

      document.getElementById('editId').value = coupon.id;
      document.getElementById('editCode').value = coupon.code;
      document.getElementById('editDiscountType').value = coupon.discountType;
      document.getElementById('editDiscountValue').value = coupon.discountValue;
      document.getElementById('editMinimumOrderAmount').value = coupon.minimumOrderAmount || 0;
      document.getElementById('editExpiresAt').value = coupon.expiresAt ? coupon.expiresAt.split('T')[0] : '';
      document.getElementById('editUsageLimit').value = coupon.usageLimit || '';

      editModal.classList.remove('hidden');
    }

    // Edit Coupon
    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();

      const id = document.getElementById('editId').value;
      const payload = {
        code: document.getElementById('editCode').value.trim(),
        discountType: document.getElementById('editDiscountType').value,
        discountValue: parseFloat(document.getElementById('editDiscountValue').value),
        minimumOrderAmount: parseFloat(document.getElementById('editMinimumOrderAmount').value),
        expiresAt: document.getElementById('editExpiresAt').value,
        usageLimit: parseInt(document.getElementById('editUsageLimit').value, 10)
      };

      try {
        const response = await fetch(`${API_URL}?id=${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.message || 'Failed to update coupon');
        }

        editModal.classList.add('hidden');
        await fetchCoupons();
      } catch (err) {
        showError(err.message || 'Failed to update coupon');
      }
    });

    // Delete Coupon
    async function deleteCoupon(id) {
      if (!confirm('Are you sure you want to delete this coupon?')) return;
      hideError();

      try {
        const response = await fetch(`${API_URL}?id=${id}`, {
          method: 'DELETE',
          credentials: 'same-origin'
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.message || 'Failed to delete coupon');
        }

        await fetchCoupons();
      } catch (err) {
        showError(err.message || 'Failed to delete coupon');
      }
    }

    // Initialize
    fetchCoupons();
  </script>
</AdminLayout>