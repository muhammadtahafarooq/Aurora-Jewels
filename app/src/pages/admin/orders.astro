---
export const prerender = false;
import { requireAdminPage } from '../../lib/admin-auth';
if (!await requireAdminPage(Astro)) return Astro.redirect('/admin/login');
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Orders">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold text-text">Orders</h1>
  </div>

  <div class="mb-4">
    <select
      id="statusFilter"
      class="bg-surface border border-border rounded-none px-3 py-2 text-text text-sm"
    >
      <option value="all">All Statuses</option>
      <option value="pending">Pending</option>
      <option value="confirmed">Confirmed</option>
      <option value="processing">Processing</option>
      <option value="shipped">Shipped</option>
      <option value="delivered">Delivered</option>
      <option value="cancelled">Cancelled</option>
    </select>
  </div>

  <div id="errorMessage" class="hidden mb-4 p-3 bg-error/10 border border-error text-error text-sm">
    Failed to load orders.
  </div>

  <div id="loadingState" class="text-muted text-sm py-8 text-center">Loading...</div>

  <div id="emptyState" class="hidden text-muted text-sm py-8 text-center">No orders found.</div>

  <div id="ordersTable" class="hidden overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-border bg-surface">
          <th class="text-left px-4 py-3 text-xs font-medium text-muted uppercase">Order #</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-muted uppercase">Customer</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-muted uppercase">Amount</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-muted uppercase">Payment</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-muted uppercase">Status</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-muted uppercase">Date</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-muted uppercase">View</th>
        </tr>
      </thead>
      <tbody id="ordersBody"></tbody>
    </table>
  </div>

  <div
    id="orderModal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"
  >
    <div class="bg-surface border border-border rounded-none w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-border px-6 py-4">
        <h2 class="text-lg font-semibold text-text">Order Detail</h2>
        <button
          id="modalClose"
          class="text-muted hover:text-text text-xl leading-none"
        >&times;</button>
      </div>
      <div id="modalContent" class="px-6 py-4 space-y-4">
        <div class="text-muted text-sm">Loading...</div>
      </div>
      <div class="border-t border-border px-6 py-4">
        <h3 class="text-sm font-medium text-text mb-3">Update Status</h3>
        <form id="statusForm" class="space-y-3">
          <div>
            <label class="block text-xs text-muted mb-1">Order Status</label>
            <select
              id="modalOrderStatus"
              class="w-full bg-surface border border-border rounded-none px-3 py-2 text-text text-sm"
            >
              <option value="pending">Pending</option>
              <option value="confirmed">Confirmed</option>
              <option value="processing">Processing</option>
              <option value="shipped">Shipped</option>
              <option value="delivered">Delivered</option>
              <option value="cancelled">Cancelled</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-muted mb-1">Payment Status</label>
            <select
              id="modalPaymentStatus"
              class="w-full bg-surface border border-border rounded-none px-3 py-2 text-text text-sm"
            >
              <option value="pending">Pending</option>
              <option value="paid">Paid</option>
              <option value="failed">Failed</option>
              <option value="refunded">Refunded</option>
            </select>
          </div>
          <div id="formError" class="hidden text-error text-xs"></div>
          <div class="flex gap-2">
            <button
              type="submit"
              class="bg-primary text-white px-4 py-2 text-sm rounded-none border border-primary"
            >
              Update
            </button>
            <button
              type="button"
              id="modalCancel"
              class="bg-surface text-text px-4 py-2 text-sm rounded-none border border-border"
            >
              Cancel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const formatter = new Intl.NumberFormat('en-PK', { minimumFractionDigits: 0 });
      const statusFilter = document.getElementById('statusFilter');
      const errorMessage = document.getElementById('errorMessage');
      const loadingState = document.getElementById('loadingState');
      const emptyState = document.getElementById('emptyState');
      const ordersTable = document.getElementById('ordersTable');
      const ordersBody = document.getElementById('ordersBody');
      const orderModal = document.getElementById('orderModal');
      const modalClose = document.getElementById('modalClose');
      const modalCancel = document.getElementById('modalCancel');
      const modalContent = document.getElementById('modalContent');
      const modalOrderStatus = document.getElementById('modalOrderStatus');
      const modalPaymentStatus = document.getElementById('modalPaymentStatus');
      const statusForm = document.getElementById('statusForm');
      const formError = document.getElementById('formError');

      let currentOrderId = null;
      let allOrders = [];

      function statusBadge(status) {
        const colors = {
          pending: 'bg-warning/10 text-warning border-warning',
          confirmed: 'bg-primary/10 text-primary border-primary',
          processing: 'bg-primary/10 text-primary border-primary',
          shipped: 'bg-accent/10 text-accent border-accent',
          delivered: 'bg-success/10 text-success border-success',
          cancelled: 'bg-error/10 text-error border-error',
        };
        const c = colors[status] || 'bg-surface text-muted border-border';
        return `<span class="inline-block px-2 py-0.5 text-xs border rounded-none ${c}">${status}</span>`;
      }

      function renderOrders(orders) {
        if (orders.length === 0) {
          ordersTable.classList.add('hidden');
          emptyState.classList.remove('hidden');
          return;
        }
        emptyState.classList.add('hidden');
        ordersTable.classList.remove('hidden');
        ordersBody.innerHTML = orders
          .map(
            (o) => `
          <tr class="border-b border-border hover:bg-surface/50">
            <td class="px-4 py-3 text-sm text-text">#${o.orderNumber || o.id}</td>
            <td class="px-4 py-3 text-sm text-text">${o.customer?.name || o.customerName || '-'}</td>
            <td class="px-4 py-3 text-sm text-text">Rs. ${formatter.format((o.totalAmount || o.total || 0) / 100)}</td>
            <td class="px-4 py-3 text-sm">${statusBadge(o.paymentStatus || 'pending')}</td>
            <td class="px-4 py-3 text-sm">${statusBadge(o.status)}</td>
            <td class="px-4 py-3 text-sm text-muted">${o.createdAt ? new Date(o.createdAt).toLocaleDateString() : '-'}</td>
            <td class="px-4 py-3 text-sm">
              <button class="text-primary hover:underline text-sm view-btn" data-id="${o.id}">View</button>
            </td>
          </tr>`
          )
          .join('');

        document.querySelectorAll('.view-btn').forEach((btn) => {
          btn.addEventListener('click', () => openModal(btn.dataset.id));
        });
      }

      async function fetchOrders() {
        loadingState.classList.remove('hidden');
        errorMessage.classList.add('hidden');
        ordersTable.classList.add('hidden');
        emptyState.classList.add('hidden');

        try {
          const params = new URLSearchParams();
          const status = statusFilter.value;
          if (status && status !== 'all') params.set('status', status);

          const qs = params.toString() ? `?${params.toString()}` : '';
          const res = await fetch(`/api/admin/orders${qs}`, { credentials: 'same-origin' });
          if (!res.ok) throw new Error('Failed');
          const data = await res.json();
          allOrders = Array.isArray(data) ? data : data.orders || [];
          renderOrders(allOrders);
        } catch {
          loadingState.classList.add('hidden');
          errorMessage.classList.remove('hidden');
          return;
        }
        loadingState.classList.add('hidden');
      }

      async function openModal(id) {
        currentOrderId = id;
        orderModal.classList.remove('hidden');
        modalContent.innerHTML = '<div class="text-muted text-sm">Loading...</div>';
        formError.classList.add('hidden');

        try {
          const res = await fetch(`/api/admin/orders?id=${id}`, { credentials: 'same-origin' });
          if (!res.ok) throw new Error('Failed');
          const order = await res.json();

          modalOrderStatus.value = order.status || 'pending';
          modalPaymentStatus.value = order.paymentStatus || 'pending';

          modalContent.innerHTML = `
            <div class="space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-muted">Order #</span>
                <span class="text-text font-medium">#${order.orderNumber || order.id}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted">Customer</span>
                <span class="text-text">${order.customer?.name || order.customerName || '-'}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted">Email</span>
                <span class="text-text">${order.customer?.email || order.email || '-'}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted">Amount</span>
                <span class="text-text">Rs. ${formatter.format((order.totalAmount || order.total || 0) / 100)}</span>
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted">Payment</span>
                ${statusBadge(order.paymentStatus || 'pending')}
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted">Status</span>
                ${statusBadge(order.status)}
              </div>
              <div class="flex justify-between text-sm">
                <span class="text-muted">Date</span>
                <span class="text-text">${order.createdAt ? new Date(order.createdAt).toLocaleDateString() : '-'}</span>
              </div>
              ${order.items && order.items.length ? `
              <div class="mt-3 border-t border-border pt-3">
                <span class="text-xs text-muted uppercase font-medium">Items</span>
                <div class="mt-2 space-y-1">
                  ${order.items
                    .map(
                      (item) => `
                    <div class="flex justify-between text-sm">
                      <span class="text-text">${item.name || item.productName || 'Item'} x${item.quantity || 1}</span>
                      <span class="text-muted">Rs. ${formatter.format(((item.price || item.unitPrice || 0) * (item.quantity || 1)) / 100)}</span>
                    </div>`
                    )
                    .join('')}
                </div>
              </div>` : ''}
              ${order.shippingAddress ? `
              <div class="mt-3 border-t border-border pt-3">
                <span class="text-xs text-muted uppercase font-medium">Shipping Address</span>
                <p class="text-sm text-text mt-1">${order.shippingAddress}</p>
              </div>` : ''}
            </div>`;
        } catch {
          modalContent.innerHTML =
            '<div class="text-error text-sm">Failed to load order details.</div>';
        }
      }

      modalClose.addEventListener('click', () => orderModal.classList.add('hidden'));
      modalCancel.addEventListener('click', () => orderModal.classList.add('hidden'));
      orderModal.addEventListener('click', (e) => {
        if (e.target === orderModal) orderModal.classList.add('hidden');
      });

      statusForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentOrderId) return;
        formError.classList.add('hidden');

        const submitBtn = statusForm.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Updating...';

        try {
          const res = await fetch(`/api/admin/orders?id=${currentOrderId}`, {
            method: 'PATCH',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              status: modalOrderStatus.value,
              paymentStatus: modalPaymentStatus.value,
            }),
          });
          if (!res.ok) throw new Error('Failed');
          orderModal.classList.add('hidden');
          fetchOrders();
        } catch {
          formError.textContent = 'Failed to update order.';
          formError.classList.remove('hidden');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Update';
        }
      });

      statusFilter.addEventListener('change', fetchOrders);
      fetchOrders();
    })();
  </script>
</AdminLayout>