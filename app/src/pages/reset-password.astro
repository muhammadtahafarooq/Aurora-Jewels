---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const token = url.searchParams.get('token');
---

<Layout title="Reset Password — Aurora Jewels" description="Set a new password for your Aurora Jewels account.">
  <section class="flex min-h-screen items-center justify-center px-6 py-24">
    <div class="w-full max-w-md">
      <h1 class="type-h3 mb-2 text-center">Reset Password</h1>
      <p class="mb-10 text-center text-sm text-muted">Enter your new password below.</p>

      {token ? (
        <div id="reset-token" data-token={token} class="hidden"></div>

        <div id="error-box" class="mb-6 hidden border border-error/30 bg-error/5 px-4 py-3 text-sm text-error">
          <p id="error-text"></p>
        </div>

        <div id="success-box" class="mb-6 hidden border border-success/30 bg-success/5 px-4 py-3 text-sm text-success">
          <p id="success-text"></p>
        </div>

        <form id="reset-form" novalidate>
          <div class="mb-5">
            <label for="password" class="form-label">New Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="input-field"
              required
              minlength="8"
              autocomplete="new-password"
            />
            <p class="mt-1 text-xs text-muted">Minimum 8 characters.</p>
          </div>

          <div class="mb-8">
            <label for="confirm-password" class="form-label">Confirm Password</label>
            <input
              type="password"
              id="confirm-password"
              name="confirm-password"
              class="input-field"
              required
              minlength="8"
              autocomplete="new-password"
            />
          </div>

          <button type="submit" id="submit-btn" class="btn-primary w-full">
            <span id="btn-label">Reset Password</span>
            <span id="btn-spinner" class="hidden">
              <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </span>
          </button>
        </form>
      ) : (
        <div class="border border-error/30 bg-error/5 px-4 py-3 text-sm text-error">
          <p>No reset token provided.</p>
        </div>
      )}

      <p class="mt-8 text-center text-sm text-muted">
        <a href="/login" class="link-underline font-semibold text-text">Back to login</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  function init() {
    const form = document.getElementById('reset-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnLabel = document.getElementById('btn-label');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorBox = document.getElementById('error-box');
    const errorText = document.getElementById('error-text');
    const successBox = document.getElementById('success-box');
    const successText = document.getElementById('success-text');
    const tokenEl = document.getElementById('reset-token');

    if (!form || !submitBtn || !tokenEl) return;

    const token = tokenEl.getAttribute('data-token');

    function setLoading(loading: boolean) {
      if (loading) {
        submitBtn!.classList.add('btn-loading');
        submitBtn!.disabled = true;
        btnLabel!.classList.add('hidden');
        btnSpinner!.classList.remove('hidden');
      } else {
        submitBtn!.classList.remove('btn-loading');
        submitBtn!.disabled = false;
        btnLabel!.classList.remove('hidden');
        btnSpinner!.classList.add('hidden');
      }
    }

    function showError(msg: string) {
      if (errorBox && errorText) {
        errorText.textContent = msg;
        errorBox.classList.remove('hidden');
      }
      if (successBox) successBox.classList.add('hidden');
    }

    function showSuccess(msg: string) {
      if (successBox && successText) {
        successText.textContent = msg;
        successBox.classList.remove('hidden');
      }
      if (errorBox) errorBox.classList.add('hidden');
    }

    function hideMessages() {
      if (errorBox) errorBox.classList.add('hidden');
      if (successBox) successBox.classList.add('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMessages();

      const password = (form.querySelector('#password') as HTMLInputElement).value;
      const confirmPassword = (form.querySelector('#confirm-password') as HTMLInputElement).value;

      if (!password || password.length < 8) {
        showError('Password must be at least 8 characters.');
        return;
      }

      if (password !== confirmPassword) {
        showError('Passwords do not match.');
        return;
      }

      setLoading(true);

      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password }),
        });

        const data = await res.json();

        if (!res.ok) {
          showError(data.error || data.message || 'Reset failed. Please try again.');
          return;
        }

        showSuccess('Password reset successfully!');
        const loginLink = document.createElement('a');
        loginLink.href = '/login';
        loginLink.className = 'link-underline font-semibold';
        loginLink.textContent = 'Log in';
        if (successText) successText.appendChild(loginLink);
        form.reset();
      } catch {
        showError('An unexpected error occurred. Please try again.');
      } finally {
        setLoading(false);
      }
    });
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
