---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page Not Found — Aurora Jewels" description="The page you are looking for could not be found.">
  <div class="py-16 text-center">
    <Icon name="search" size={48} class="text-text-secondary" />
    <h1 class="type-h4 mt-4">Page not found</h1>
    <p class="mt-2 text-[14px] text-text-secondary">The page you are looking for may have moved or no longer exists.</p>
    <a href="/" class="btn-primary mt-6">Return to Home</a>
  </div>
</Layout>
