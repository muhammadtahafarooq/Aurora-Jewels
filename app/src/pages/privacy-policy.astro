---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy — Aurora Jewels" description="How Aurora Jewels collects, uses and protects your information.">
  <!-- Page Header — centered -->
  <section class="mx-auto max-w-[1440px] px-5 pb-12 pt-[120px] text-center md:pb-16 md:pt-[160px]">
    <h1 class="type-h2">Privacy Policy</h1>
  </section>

  <section class="mx-auto max-w-[1440px] border-t border-border px-5 py-12 md:px-10 md:py-16">
    <article class="mx-auto max-w-[760px] text-[16px] leading-[1.65] text-text-secondary">
      <p>
        This policy describes how Aurora Jewels handles your personal information. The final
        legal content is supplied and approved by the business prior to launch.
      </p>

      <h2 class="type-h4 mt-10 text-text">Information We Collect</h2>
      <p class="mt-3">
        We collect the information you provide when placing an order or contacting us, such as
        your name, contact details and delivery address.
      </p>

      <h2 class="type-h4 mt-10 text-text">How We Use Information</h2>
      <p class="mt-3">
        Your information is used to fulfil orders, provide customer support and improve our
        services. We do not sell personal information.
      </p>

      <h2 class="type-h4 mt-10 text-text">Contact</h2>
      <p class="mt-3">
        Questions about this policy can be directed to us through the
        <a href="/contact" class="text-primary link-underline">contact page</a>.
      </p>
    </article>

    <!-- Related Legal Navigation -->
    <nav class="mx-auto mt-16 flex flex-wrap gap-x-10 gap-y-3 border-t border-border pt-8" aria-label="Related legal pages">
      <a href="/terms-conditions" class="btn-text"><span class="link-underline">Terms &amp; Conditions</span></a>
      <a href="/shipping-returns" class="btn-text"><span class="link-underline">Shipping &amp; Returns</span></a>
      <a href="/contact" class="btn-text"><span class="link-underline">Contact</span></a>
    </nav>
  </section>
</Layout>
