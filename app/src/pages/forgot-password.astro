---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Forgot Password — Aurora Jewels" description="Reset your Aurora Jewels account password." minimal>
  <div class="flex min-h-screen items-center justify-center px-5">
    <div class="w-full max-w-[400px]">
      <div class="mb-10 text-center">
        <a href="/" class="font-display text-[20px] font-medium uppercase tracking-[0.18em]" aria-label="Aurora Jewels home">
          Aurora&nbsp;Jewels
        </a>
      </div>

      <h1 class="type-h4 mb-4 text-center">Forgot Password</h1>
      <p class="mb-8 text-center text-[14px] text-text-secondary">
        Enter your email and we'll send you a reset link.
      </p>

      <div id="success-box" class="mb-6 hidden border border-success/30 bg-success/5 px-4 py-3 text-sm text-success">
        <p id="success-text"></p>
      </div>

      <div id="error-box" class="mb-6 hidden border border-error/30 bg-error/5 px-4 py-3 text-sm text-error">
        <p id="error-text"></p>
      </div>

      <form id="forgot-form" class="flex flex-col gap-6" novalidate>
        <div>
          <label for="email" class="form-label">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="input-field" />
        </div>

        <button type="submit" id="forgot-btn" class="btn-primary w-full">
          <span id="btn-label">Send Reset Link</span>
          <span id="btn-spinner" class="hidden">
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </span>
        </button>
      </form>

      <p class="mt-8 text-center text-[14px] text-text-secondary">
        <a href="/login" class="font-medium text-primary hover:text-primary-hover">Back to login</a>
      </p>
    </div>
  </div>

  <script>
    function initForgot() {
      const form = document.getElementById('forgot-form') as HTMLFormElement | null;
      const submitBtn = document.getElementById('forgot-btn') as HTMLButtonElement | null;
      const btnLabel = document.getElementById('btn-label');
      const btnSpinner = document.getElementById('btn-spinner');
      const errorBox = document.getElementById('error-box');
      const errorText = document.getElementById('error-text');
      const successBox = document.getElementById('success-box');
      const successText = document.getElementById('success-text');

      if (!form || !submitBtn) return;

      function setLoading(loading: boolean) {
        if (loading) {
          submitBtn!.classList.add('btn-loading');
          submitBtn!.disabled = true;
          btnLabel!.classList.add('hidden');
          btnSpinner!.classList.remove('hidden');
        } else {
          submitBtn!.classList.remove('btn-loading');
          submitBtn!.disabled = false;
          btnLabel!.classList.remove('hidden');
          btnSpinner!.classList.add('hidden');
        }
      }

      function showError(msg: string) {
        if (errorBox && errorText) {
          errorText.textContent = msg;
          errorBox.classList.remove('hidden');
        }
        if (successBox) successBox.classList.add('hidden');
      }

      function showSuccess(msg: string) {
        if (successBox && successText) {
          successText.textContent = msg;
          successBox.classList.remove('hidden');
        }
        if (errorBox) errorBox.classList.add('hidden');
      }

      function hideMessages() {
        if (errorBox) errorBox.classList.add('hidden');
        if (successBox) successBox.classList.add('hidden');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideMessages();

        const email = (form.querySelector('#email') as HTMLInputElement).value.trim();

        if (!email) {
          showError('Email is required.');
          return;
        }

        setLoading(true);

        try {
          await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
        } catch {
          showError('Something went wrong. Please try again.');
          setLoading(false);
          return;
        }

        setLoading(false);
        form.reset();
        showSuccess('If an account with that email exists, a reset link has been sent.');
      });
    }

    initForgot();
    document.addEventListener('astro:after-swap', initForgot);
  </script>
</Layout>
