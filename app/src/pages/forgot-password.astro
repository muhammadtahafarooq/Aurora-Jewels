---
import Layout from '../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Forgot Password — Aurora Jewels" description="Reset your Aurora Jewels account password." minimal>
  <div class="flex min-h-screen items-center justify-center px-5">
    <div class="w-full max-w-[400px]">
      <div class="mb-10 text-center">
        <a href="/" class="font-display text-[20px] font-medium uppercase tracking-[0.18em]" aria-label="Aurora Jewels home">
          Aurora&nbsp;Jewels
        </a>
      </div>

      <h1 class="type-h4 mb-4 text-center">Reset Password</h1>
      <p class="mb-8 text-center text-[14px] text-text-secondary">
        Enter your email and we'll send you a verification code.
      </p>

      <div id="success-box" class="mb-6 hidden border border-success/30 bg-success/5 px-4 py-3 text-sm text-success">
        <p id="success-text"></p>
      </div>

      <div id="error-box" class="mb-6 hidden border border-error/30 bg-error/5 px-4 py-3 text-sm text-error">
        <p id="error-text"></p>
      </div>

      <!-- Step 1: Enter Email -->
      <form id="step1-form" class="flex flex-col gap-6" novalidate>
        <div>
          <label for="email" class="form-label">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="input-field" />
        </div>

        <button type="submit" class="btn-primary w-full">
          <span id="step1-label">Send Code</span>
          <span id="step1-spinner" class="hidden">
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </span>
        </button>
      </form>

      <!-- Step 2: OTP + New Password -->
      <form id="step2-form" class="hidden flex-col gap-6" novalidate>
        <p class="text-[14px] text-text-secondary">
          We sent a 6-digit code to <strong id="reset-email-display"></strong>.
        </p>

        <div>
          <label for="otp-code" class="form-label">Verification Code</label>
          <input type="text" id="otp-code" name="otpCode" class="input-field" required inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code" />
        </div>

        <div>
          <label for="new-password" class="form-label">New Password</label>
          <input type="password" id="new-password" name="password" class="input-field" required minlength="8" autocomplete="new-password" />
          <p class="mt-1 text-xs text-muted">Minimum 8 characters.</p>
        </div>

        <button type="submit" class="btn-primary w-full">
          <span id="step2-label">Reset Password</span>
          <span id="step2-spinner" class="hidden">
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </span>
        </button>

        <button type="button" id="resend-otp" class="text-[13px] font-medium text-primary hover:text-primary-hover text-center">
          Resend code
        </button>
      </form>

      <!-- Step 3: Success -->
      <div id="step3" class="hidden text-center">
        <p class="text-[14px] text-success font-semibold mb-4">Password reset successfully.</p>
        <a href="/login" class="btn-primary inline-block">Sign In</a>
      </div>

      <p class="mt-8 text-center text-[14px] text-text-secondary">
        <a href="/login" class="font-medium text-primary hover:text-primary-hover">Back to login</a>
      </p>
    </div>
  </div>

  <script>
    function initForgot() {
      const step1 = document.getElementById('step1-form') as HTMLFormElement | null;
      const step2 = document.getElementById('step2-form') as HTMLFormElement | null;
      const step3 = document.getElementById('step3');
      const errorBox = document.getElementById('error-box');
      const errorText = document.getElementById('error-text');
      const successBox = document.getElementById('success-box');
      const successText = document.getElementById('success-text');
      const emailDisplay = document.getElementById('reset-email-display');

      if (!step1 || !step2) return;

      let emailValue = '';

      function showError(msg: string) {
        if (errorBox && errorText) { errorText.textContent = msg; errorBox.classList.remove('hidden'); }
        if (successBox) successBox.classList.add('hidden');
      }

      function showSuccess(msg: string) {
        if (successBox && successText) { successText.textContent = msg; successBox.classList.remove('hidden'); }
        if (errorBox) errorBox.classList.add('hidden');
      }

      function hideMessages() { errorBox?.classList.add('hidden'); successBox?.classList.add('hidden'); }

      function setLoading(btn: string, loading: boolean) {
        const label = document.getElementById(`${btn}-label`);
        const spinner = document.getElementById(`${btn}-spinner`);
        const button = (label?.closest('button')) as HTMLButtonElement | null;
        if (loading) { button?.classList.add('btn-loading'); if (button) button.disabled = true; label?.classList.add('hidden'); spinner?.classList.remove('hidden'); }
        else { button?.classList.remove('btn-loading'); if (button) button.disabled = false; label?.classList.remove('hidden'); spinner?.classList.add('hidden'); }
      }

      // Step 1: Send OTP
      step1.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideMessages();
        emailValue = (document.getElementById('email') as HTMLInputElement).value.trim();
        if (!emailValue) { showError('Email is required.'); return; }

        setLoading('step1', true);
        try {
          const res = await fetch('/api/auth/send-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailValue, purpose: 'reset_password' }),
          });
          const data = await res.json();
          if (!res.ok) { showError(data.error || 'Failed to send code.'); setLoading('step1', false); return; }

          if (emailDisplay) emailDisplay.textContent = emailValue;
          step1.classList.add('hidden');
          step2.classList.remove('hidden');
          step2.classList.add('flex');
          showSuccess('Code sent. Check your inbox.');
        } catch { showError('Something went wrong.'); }
        finally { setLoading('step1', false); }
      });

      // Resend
      document.getElementById('resend-otp')?.addEventListener('click', async () => {
        hideMessages();
        try {
          await fetch('/api/auth/send-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailValue, purpose: 'reset_password' }),
          });
          showSuccess('New code sent.');
        } catch { showError('Failed to resend.'); }
      });

      // Step 2: Reset with OTP
      step2.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideMessages();
        const code = (document.getElementById('otp-code') as HTMLInputElement).value.trim();
        const password = (document.getElementById('new-password') as HTMLInputElement).value;
        if (!code || code.length !== 6) { showError('Please enter the 6-digit code.'); return; }
        if (!password || password.length < 8) { showError('Password must be at least 8 characters.'); return; }

        setLoading('step2', true);
        try {
          const res = await fetch('/api/auth/reset-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailValue, otpCode: code, password }),
          });
          const data = await res.json();
          if (!res.ok) { showError(data.error || 'Reset failed.'); setLoading('step2', false); return; }

          step2.classList.add('hidden');
          step3?.classList.remove('hidden');
        } catch { showError('Reset failed.'); }
        finally { setLoading('step2', false); }
      });
    }

    initForgot();
    document.addEventListener('astro:after-swap', initForgot);
  </script>
</Layout>
