---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms & Conditions — Aurora Jewels" description="Terms and conditions for using the Aurora Jewels website and purchasing our products.">
  <!-- Page Header — centered -->
  <section class="mx-auto max-w-[1440px] px-5 pb-12 pt-[120px] text-center md:pb-16 md:pt-[160px]">
    <h1 class="type-h2">Terms &amp; Conditions</h1>
  </section>

  <section class="mx-auto max-w-[1440px] border-t border-border px-5 py-12 md:px-10 md:py-16">
    <article class="mx-auto max-w-[760px] text-[16px] leading-[1.65] text-text-secondary">
      <p>
        These terms govern your use of the Aurora Jewels website. The final legal content is
        supplied and approved by the business prior to launch.
      </p>

      <h2 class="type-h4 mt-10 text-text">Orders</h2>
      <p class="mt-3">
        All orders are subject to confirmation. Cash on Delivery orders are confirmed by phone
        before dispatch.
      </p>

      <h2 class="type-h4 mt-10 text-text">Pricing</h2>
      <p class="mt-3">
        Prices are listed in Pakistani Rupees and are subject to change without notice. The price
        confirmed at checkout is the price you pay.
      </p>

      <h2 class="type-h4 mt-10 text-text">Contact</h2>
      <p class="mt-3">
        Questions about these terms can be directed to us through the
        <a href="/contact" class="text-primary link-underline">contact page</a>.
      </p>
    </article>

    <!-- Related Legal Navigation -->
    <nav class="mx-auto mt-16 flex flex-wrap gap-x-10 gap-y-3 border-t border-border pt-8" aria-label="Related legal pages">
      <a href="/privacy-policy" class="btn-text"><span class="link-underline">Privacy Policy</span></a>
      <a href="/shipping-returns" class="btn-text"><span class="link-underline">Shipping &amp; Returns</span></a>
      <a href="/contact" class="btn-text"><span class="link-underline">Contact</span></a>
    </nav>
  </section>
</Layout>
