---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Visit Us — Aurora Jewels" description="Visit the Aurora Jewels studio in Karachi, Pakistan. Find our location, opening hours and get in touch.">
  <section class="mx-auto max-w-[1440px] px-5 pb-12 pt-[120px] text-center md:pb-16 md:pt-[160px]">
    <span class="type-eyebrow text-accent" data-reveal-eyebrow>Find Us</span>
    <h1 class="type-h2 mt-4" data-reveal-text>Visit Our Studio</h1>
    <p class="mx-auto mt-4 max-w-[520px] text-text-secondary">
      We welcome visitors by appointment. Drop by to view our collections in person.
    </p>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-10 px-5 py-12 md:grid-cols-2 md:gap-6 md:px-10 md:py-16">
      <div class="aspect-[4/3] overflow-hidden bg-surface-warm">
        <img
          src="/images/contact/map.jpg"
          alt="Aurora Jewels studio location map"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>

      <div class="flex flex-col justify-center gap-8">
        <div>
          <h2 class="type-h4">Aurora Jewels Studio</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-text-secondary">
            House 14, Street 12,<br />
            Clifton Block 5,<br />
            Karachi, Pakistan
          </p>
        </div>

        <div>
          <h3 class="text-[14px] font-semibold">Opening Hours</h3>
          <p class="mt-2 text-[14px] text-text-secondary">
            Monday – Saturday: 11:00 AM – 7:00 PM<br />
            Sunday: By appointment only
          </p>
        </div>

        <div>
          <h3 class="text-[14px] font-semibold">Get in Touch</h3>
          <div class="mt-3 flex flex-col gap-2">
            <a href="tel:+923001234567" class="flex items-center gap-2 text-[14px] text-text-secondary hover:text-primary transition-colors">
              <Icon name="phone" size={16} class="text-primary" />
              +92 300 123 4567
            </a>
            <a href="mailto:hello@aurorajewels.pk" class="flex items-center gap-2 text-[14px] text-text-secondary hover:text-primary transition-colors">
              <Icon name="alert" size={16} class="text-primary" />
              hello@aurorajewels.pk
            </a>
            <a href="https://wa.me/923001234567" target="_blank" rel="noopener" class="flex items-center gap-2 text-[14px] text-text-secondary hover:text-primary transition-colors">
              <Icon name="heart" size={16} class="text-primary" />
              WhatsApp Us
            </a>
          </div>
        </div>

        <div>
          <a href="https://maps.google.com/?q=Aurora+Jewels+Clifton+Karachi" target="_blank" rel="noopener" class="btn-primary inline-block">
            Get Directions
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
