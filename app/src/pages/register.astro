---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Create Account — Aurora Jewels" description="Create an Aurora Jewels account for an exclusive shopping experience.">
  <section class="flex min-h-screen items-center justify-center px-6 py-24">
    <div class="w-full max-w-md">
      <h1 class="type-h3 mb-2 text-center">Create Account</h1>
      <p class="mb-10 text-center text-sm text-muted">Join Aurora Jewels for an exclusive experience.</p>

      <div id="error-box" class="mb-6 hidden border border-error/30 bg-error/5 px-4 py-3 text-sm text-error">
        <p id="error-text"></p>
      </div>

      <div id="success-box" class="mb-6 hidden border border-success/30 bg-success/5 px-4 py-3 text-sm text-success">
        <p id="success-text"></p>
      </div>

      <form id="register-form" novalidate>
        <div class="mb-5 grid grid-cols-2 gap-4">
          <div>
            <label for="firstName" class="form-label">First Name</label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              class="input-field"
              autocomplete="given-name"
            />
          </div>
          <div>
            <label for="lastName" class="form-label">Last Name</label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              class="input-field"
              autocomplete="family-name"
            />
          </div>
        </div>

        <div class="mb-5">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="input-field"
            required
            autocomplete="email"
          />
        </div>

        <div class="mb-8">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="input-field"
            required
            minlength="8"
            autocomplete="new-password"
          />
          <p class="mt-1 text-xs text-muted">Minimum 8 characters.</p>
        </div>

        <button type="submit" id="submit-btn" class="btn-primary w-full">
          <span id="btn-label">Create Account</span>
          <span id="btn-spinner" class="hidden">
            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </span>
        </button>
      </form>

      <p class="mt-8 text-center text-sm text-muted">
        Already have an account?{' '}
        <a href="/login" class="link-underline font-semibold text-text">Log in</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  function init() {
    const form = document.getElementById('register-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnLabel = document.getElementById('btn-label');
    const btnSpinner = document.getElementById('btn-spinner');
    const errorBox = document.getElementById('error-box');
    const errorText = document.getElementById('error-text');
    const successBox = document.getElementById('success-box');
    const successText = document.getElementById('success-text');

    if (!form || !submitBtn) return;

    async function checkAuth() {
      try {
        const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
        if (res.ok) {
          const data = await res.json();
          if (data?.role === 'admin') {
            window.location.href = '/admin/dashboard';
          } else {
            window.location.href = '/account/profile';
          }
        }
      } catch {
        // Not logged in — stay on page.
      }
    }

    function setLoading(loading: boolean) {
      if (loading) {
        submitBtn!.classList.add('btn-loading');
        submitBtn!.disabled = true;
        btnLabel!.classList.add('hidden');
        btnSpinner!.classList.remove('hidden');
      } else {
        submitBtn!.classList.remove('btn-loading');
        submitBtn!.disabled = false;
        btnLabel!.classList.remove('hidden');
        btnSpinner!.classList.add('hidden');
      }
    }

    function showError(msg: string) {
      if (errorBox && errorText) {
        errorText.textContent = msg;
        errorBox.classList.remove('hidden');
      }
      if (successBox) successBox.classList.add('hidden');
    }

    function showSuccess(msg: string) {
      if (successBox && successText) {
        successText.textContent = msg;
        successBox.classList.remove('hidden');
      }
      if (errorBox) errorBox.classList.add('hidden');
    }

    function hideMessages() {
      if (errorBox) errorBox.classList.add('hidden');
      if (successBox) successBox.classList.add('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMessages();

      const email = (form.querySelector('#email') as HTMLInputElement).value.trim();
      const password = (form.querySelector('#password') as HTMLInputElement).value;
      const firstName = (form.querySelector('#firstName') as HTMLInputElement).value.trim();
      const lastName = (form.querySelector('#lastName') as HTMLInputElement).value.trim();

      if (!email) {
        showError('Email is required.');
        return;
      }
      if (!password || password.length < 8) {
        showError('Password must be at least 8 characters.');
        return;
      }

      setLoading(true);

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, firstName, lastName }),
        });

        const data = await res.json();

        if (!res.ok) {
          showError(data.error || data.message || 'Registration failed. Please try again.');
          return;
        }

        showSuccess(
          'Account created! Please check your email to verify your account. '
        );
        const loginLink = document.createElement('a');
        loginLink.href = '/login';
        loginLink.className = 'link-underline font-semibold';
        loginLink.textContent = 'Log in';
        if (successText) successText.appendChild(loginLink);
        form.reset();
      } catch (err) {
        showError('An unexpected error occurred. Please try again.');
      } finally {
        setLoading(false);
      }
    });

    checkAuth();
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
