---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { createDb } from '../lib/db';

export const prerender = false;

function formatPrice(minorUnits: number): string {
  return new Intl.NumberFormat('en-PK', { minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(Math.round(minorUnits / 100));
}

let newArrivals: any[] = [];

const env = (Astro.locals as any).runtime?.env;
if (env?.DB) {
  const db = createDb(env);
  const { listProducts } = await import('../services/products');
  const { productVariants } = await import('@database/schema');
  const { inArray } = await import('drizzle-orm');

  const result = await listProducts(db, { page: 1, perPage: 20 });
  const productRows = result.products || [];

  if (productRows.length > 0) {
    const ids = productRows.map((p: any) => p.id);
    const defaultVariants = await db
      .select({ productId: productVariants.productId, price: productVariants.price })
      .from(productVariants)
      .where(inArray(productVariants.productId, ids));
    const priceMap = new Map(defaultVariants.map((v) => [v.productId, v.price]));
    newArrivals = productRows.map((p: any) => ({ ...p, price: priceMap.get(p.id) ?? 0 }));
  }
}
---

<Layout title="New Arrivals — Aurora Jewels" description="The latest additions to the Aurora Jewels collection.">
  <section class="mx-auto grid max-w-[1440px] grid-cols-1 items-center gap-10 px-5 pb-12 pt-[120px] md:grid-cols-12 md:gap-6 md:px-10 md:pb-16 md:pt-[160px]" data-mouse-follow>
    <div class="md:col-span-6">
      <span class="type-eyebrow text-accent" data-reveal-eyebrow>Just Added</span>
      <h1 class="type-h2 mt-4" data-reveal-text>New Arrivals</h1>
      <p class="mt-4 max-w-[480px] text-text-secondary">
        The newest pieces to join the house — small releases, considered in full.
      </p>
    </div>
    <div data-parallax-frame class="order-first overflow-hidden md:col-span-6">
      <div data-parallax="-5" class="flex aspect-[16/9] scale-[1.08] items-center justify-center bg-surface-warm">
        <img
          src="/images/collections/aurora-gold.jpg"
          alt="New arrivals from Aurora Jewels"
          data-mouse-follow-target
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-5 py-12 md:px-10 md:py-20" aria-label="New arrivals">
    {
          newArrivals.length > 0 ? (
        <div class="grid grid-cols-2 gap-x-3 gap-y-10 md:grid-cols-4 md:gap-x-6" data-stagger>
          {newArrivals.map((product) => (
            <a href={`/products/${product.slug}`} class="group block" data-tilt>
              <div class="aspect-[4/5] overflow-hidden bg-surface-warm transition-transform duration-[600ms] ease-out group-hover:scale-[1.02]">
                <img
                  src={product.imageUrl || `/images/products/${product.slug}-1.jpg`}
                  alt={product.name}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                  onerror="this.style.display='none'"
                />
              </div>
              <h3 class="type-body-md mt-3 font-semibold">{product.name}</h3>
              <p class="type-functional-sm text-text-secondary">Rs. {formatPrice(product.price)}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="py-16 text-center text-text-secondary">No new arrivals at the moment.</p>
      )
    }
  </section>

  <section class="mx-auto grid max-w-[1440px] grid-cols-1 items-center gap-10 px-5 py-16 md:grid-cols-12 md:gap-6 md:px-10 md:py-32" data-section-reveal>
    <div class="reveal overflow-hidden md:col-span-6">
      <div class="aspect-[4/3] overflow-hidden bg-surface-warm">
        <img
          src="/images/our-story/jeweler.jpg"
          alt="Small batch jewelry craftsmanship"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
    <div class="flex flex-col items-start gap-5 md:col-span-5 md:col-start-8">
      <h2 class="type-h3" data-reveal-text>Made in small batches.</h2>
      <p class="text-[16px] leading-[1.7] text-text-secondary">
        Each release is produced in limited quantity, so every piece keeps its intention.
      </p>
      <a href="/collections" class="btn-text mt-2">
        <span class="link-underline">Explore Collections</span>
        <Icon name="arrow-right" size={16} class="arrow-shift" />
      </a>
    </div>
  </section>
</Layout>
