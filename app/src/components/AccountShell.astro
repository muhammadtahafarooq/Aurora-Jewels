---
import Icon from './Icon.astro';

interface Props {
  active: 'profile' | 'orders' | 'addresses' | 'wishlist';
  title: string;
}

const { active, title } = Astro.props;

const links = [
  { key: 'profile', label: 'Profile', href: '/account/profile', icon: 'user' as const },
  { key: 'orders', label: 'Order History', href: '/account/orders', icon: 'bag' as const },
  { key: 'addresses', label: 'Saved Addresses', href: '/account/addresses', icon: 'check' as const },
  { key: 'wishlist', label: 'Wishlist', href: '/account/wishlist', icon: 'heart' as const },
] as const;
---

<div class="mx-auto max-w-[1440px] px-5 pb-20 pt-[120px] md:px-10 md:pb-32 md:pt-[160px]">
  <header class="mb-12">
    <span class="type-eyebrow text-accent">My Account</span>
    <h1 class="type-h2 mt-3">{title}</h1>
  </header>

  <nav class="mb-12" aria-label="Account">
    <ul class="flex flex-col gap-1 border-y border-border">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'flex items-center gap-3 py-4 text-[14px] font-semibold transition-colors duration-250',
                link.key === active ? 'text-primary' : 'text-text-secondary hover:text-text',
              ]}
              aria-current={link.key === active ? 'page' : undefined}
            >
              <Icon name={link.icon} size={20} />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <slot />
</div>
