---
import Icon from './Icon.astro';

interface Props {
  title: string;
  message: string;
  ctaLabel?: string;
  ctaHref?: string;
  icon?: 'heart' | 'bag' | 'search' | 'user';
}

const { title, message, ctaLabel, ctaHref, icon = 'bag' } = Astro.props;
---

<div class="flex flex-col items-center justify-center px-5 py-24 text-center md:py-32">
  <div class="flex h-14 w-14 items-center justify-center text-muted">
    <Icon name={icon} size={24} />
  </div>
  <h2 class="type-h3 mt-6">{title}</h2>
  <p class="mt-3 max-w-[420px] text-[15px] leading-relaxed text-text-secondary">{message}</p>
  {
    ctaLabel && ctaHref && (
      <a href={ctaHref} class="btn-primary mt-8">
        {ctaLabel}
      </a>
    )
  }
</div>
