---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Aurora Jewels Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-text font-body min-h-screen">
    <div class="flex min-h-screen">
      <aside class="w-60 border-r border-border bg-surface p-6 flex flex-col gap-1 shrink-0">
        <a href="/admin/dashboard" class="text-[15px] font-semibold tracking-tight text-primary mb-6">Aurora Jewels</a>
        <span class="type-label-caps text-muted mb-2">Admin</span>
        <nav class="flex flex-col gap-1">
          <a href="/admin/dashboard" class:list={['block px-3 py-2 text-[14px] transition-colors', Astro.url.pathname === '/admin/dashboard' ? 'bg-primary text-white font-medium' : 'text-text hover:bg-surface-warm']}>Dashboard</a>
          <a href="/admin/products" class:list={['block px-3 py-2 text-[14px] transition-colors', Astro.url.pathname.startsWith('/admin/products') ? 'bg-primary text-white font-medium' : 'text-text hover:bg-surface-warm']}>Products</a>
          <a href="/admin/orders" class:list={['block px-3 py-2 text-[14px] transition-colors', Astro.url.pathname.startsWith('/admin/orders') ? 'bg-primary text-white font-medium' : 'text-text hover:bg-surface-warm']}>Orders</a>
          <a href="/admin/reviews" class:list={['block px-3 py-2 text-[14px] transition-colors', Astro.url.pathname.startsWith('/admin/reviews') ? 'bg-primary text-white font-medium' : 'text-text hover:bg-surface-warm']}>Reviews</a>
          <a href="/admin/coupons" class:list={['block px-3 py-2 text-[14px] transition-colors', Astro.url.pathname.startsWith('/admin/coupons') ? 'bg-primary text-white font-medium' : 'text-text hover:bg-surface-warm']}>Coupons</a>
        </nav>
        <div class="mt-auto pt-6 border-t border-border">
          <a href="/" class="block px-3 py-2 text-[13px] text-muted hover:text-text transition-colors">View Store</a>
          <button id="logout-btn" class="block w-full text-left px-3 py-2 text-[13px] text-muted hover:text-error transition-colors">Log Out</button>
        </div>
      </aside>
      <main class="flex-1 p-8 overflow-auto">
        <slot />
      </main>
    </div>
    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' });
        window.location.href = '/admin/login';
      });
    </script>
  </body>
</html>
